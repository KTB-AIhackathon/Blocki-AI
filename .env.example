# 이 파일을 복사해 .env로 만들고 값을 채우세요. .env는 git에 커밋하지 않습니다.
#   cp .env.example .env
#
# FastAPI 워커 전용. GitHub/Notion OAuth 앱 비밀값과 유저 토큰은 여기 두지 않습니다.
# Spring이 작업마다 X-GitHub-Pat / X-Notion-Token / X-Internal-Key 로 넘깁니다.

BLOCKI_ENV=prod
PORT=8000
INTERNAL_API_KEY=
ANTHROPIC_API_KEY=
BLOCKI_LLM_PROVIDER=anthropic
BLOCKI_LLM_MODEL=claude-sonnet-4-5
JOB_TIMEOUT=300
LOG_LEVEL=INFO
